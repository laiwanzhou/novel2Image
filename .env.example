# Local runtime configuration example.
# Copy to .env for local use. Do not commit .env.

NOVEL_VIS_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/novel_visualization
NOVEL_VIS_TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:55432/novel_visualization_test
NOVEL_VIS_EMBEDDING_PROVIDER=fake

# Default test/development extraction provider.
NOVEL_VIS_LLM_PROVIDER=fake

# Optional OpenAI-compatible FastGPT provider.
# NOVEL_VIS_LLM_PROVIDER=fastgpt
# NOVEL_VIS_LLM_API_BASE=https://api.deepseek.com
# NOVEL_VIS_LLM_API_KEY=replace-with-your-key
# NOVEL_VIS_LLM_MODEL=deepseek-v4-pro
# NOVEL_VIS_LLM_JSON_MODE=true
# NOVEL_VIS_LLM_MAX_TOKENS=4096
# NOVEL_VIS_LLM_TIMEOUT_SECONDS=300
